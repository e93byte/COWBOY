# COWBOY Environment Configuration
PORT=3213
HOSTNAME=127.0.0.1
NODE_ENV=development

# Account and Pick storage directory (defaults to .cowboy-data/ in repository root)
COWBOY_DATA_DIR=

# Playwright E2E testing base URL
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3213

# Supabase account/pick storage (optional — file store is used when unset)
