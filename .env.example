# COWBOY_SUPABASE_URL=https://hdkdsbxgfknxexoeyxci.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server-only; never expose to the browser

# The Odds API key (optional — ESPN keyless odds used when unset)
